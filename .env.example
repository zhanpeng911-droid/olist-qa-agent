# DeepSeek LLM 配置（M1 联调用）
# 复制本文件为 .env 并填入你的 key（代码读取环境变量，可用 dotenv 或 shell 导出）
DEEPSEEK_API_KEY=sk-xxxx
# 可选
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 真实 MySQL（run.py --db mysql 时使用）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=olist
