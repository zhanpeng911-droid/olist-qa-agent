# DeepSeek LLM 配置（M1 联调用）
# 复制本文件为 .env 并填入你的 key（代码读取环境变量，可用 dotenv 或 shell 导出）
DEEPSEEK_API_KEY=sk-xxxx
# 可选
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_TIMEOUT_SECONDS=45

# 演示样本 CSV 所在目录；不填时默认读取 data/sample
# PROJECT_DATA_DIR=data/sample

# 真实 MySQL（run.py --db mysql 时使用）
# 安全建议：正式使用时请改用仅授予三张 Mart 表 SELECT 权限的只读账号，
# 避免使用 root 或弱密码直连。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=olist_ecommerce
# 你的数据库中商品项 Mart 表实际名称
DB_ITEM_TABLE=mart_order_item_business

# 正式 UI 使用完整 MySQL 数据源（默认不设则走演示样本 CSV）
# USE_MYSQL=1
# 会话历史存储（chat_session / chat_message 表）复用上面的 DB_* 连接
